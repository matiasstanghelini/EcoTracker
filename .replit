modules = ["web", "nodejs-20"]
run = "npm run watch"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run watch"]

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 17535726
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ng serve --host 0.0.0.0 --port 4200"
